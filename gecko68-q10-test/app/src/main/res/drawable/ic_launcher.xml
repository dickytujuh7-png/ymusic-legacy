<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp"/>
            <gradient android:angle="135" android:startColor="#242424" android:endColor="#050505"/>
            <stroke android:width="3dp" android:color="#E50914"/>
        </shape>
    </item>
    <item android:left="18dp" android:top="40dp" android:right="18dp" android:bottom="40dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <gradient android:angle="90" android:startColor="#FF3434" android:endColor="#D50000"/>
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size android:width="18dp" android:height="30dp"/>
            <corners android:radius="3dp"/><solid android:color="#FFFFFF"/>
        </shape>
    </item>
    <item android:gravity="top|right" android:right="24dp" android:top="18dp">
        <shape android:shape="oval">
            <size android:width="23dp" android:height="23dp"/>
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
    <item android:gravity="top|right" android:right="31dp" android:top="25dp">
        <shape android:shape="oval">
            <size android:width="9dp" android:height="9dp"/>
            <solid android:color="#111111"/>
        </shape>
    </item>
</layer-list>